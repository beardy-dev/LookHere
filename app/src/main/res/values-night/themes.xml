<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose supplies its own Material3 theming;
         this only sets the window background before Compose content loads. -->
    <style name="Theme.LookHere" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
