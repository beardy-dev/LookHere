<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose supplies its own Material3 theming;
         this only sets the window background before Compose content loads. -->
    <style name="Theme.LookHere" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Shown briefly on launch via androidx.core.splashscreen (backports the
         Android 12+ SplashScreen look to API 26+); MainActivity switches back
         to Theme.LookHere itself once content is ready. -->
    <style name="Theme.LookHere.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lookhere_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LookHere</item>
    </style>
</resources>
