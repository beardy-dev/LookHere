# Copy this file to keystore.properties (already gitignored) and fill in real
# values once you've generated a release keystore. See README.md for how it
# was created and how to back it up -- losing it means you can never publish
# an update to an already-released app under the same identity.

storeFile=keystore/lookhere-release.jks
storePassword=
keyAlias=lookhere
keyPassword=
